# =============================================================================
# Vovingo environment variables
# Copy to .env.local and fill in values. Never commit .env.local.
# =============================================================================

# --- Cloudflare (REQUIRED for local development) -----------------------------
# Account ID (Cloudflare dashboard -> Overview)
CLOUDFLARE_ACCOUNT_ID=

# D1 database ID (wrangler d1 list)
D1_DATABASE_ID=

# How the app talks to D1:
#   wrangler-oauth -> dev on your machine, uses your `wrangler login` credentials
#                     (reads ~/.wrangler config; run `npx wrangler login` first)
#   api-token      -> uses CLOUDFLARE_API_TOKEN (recommended for CI)
#   binding        -> Cloudflare Workers binding (set automatically in production
#                     via wrangler.jsonc vars; requires no token)
D1_AUTH_MODE=wrangler-oauth

# Optional: API token with "Account -> D1 -> Edit" permission (for CI).
# CLOUDFLARE_API_TOKEN=

# --- Cloudflare R2 -----------------------------------------------------------
R2_BUCKET_NAME=

# Storage driver:
#   local   -> files under LOCAL_STORAGE_DIR (default development driver)
#   r2      -> R2 binding (automatic in production via wrangler.jsonc)
#   r2-s3   -> R2 S3-compatible API using the keys below (optional)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/uploads
# R2_S3_ACCESS_KEY_ID=
# R2_S3_SECRET_ACCESS_KEY=
# R2_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# --- Auth --------------------------------------------------------------------
# HMAC secret for session cookies (generate: node -e "crypto.randomBytes(32)...")
AUTH_SECRET=
SESSION_COOKIE_NAME=vovingo_session
SESSION_TTL_DAYS=30

# --- AI provider -------------------------------------------------------------
# mock      -> built-in deterministic heuristic analyzers (no key needed).
#              Refuses to run in production unless ALLOW_MOCK_AI=true.
# openai    -> requires OPENAI_API_KEY
# anthropic -> requires ANTHROPIC_API_KEY
AI_PROVIDER=mock
ALLOW_MOCK_AI=true
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_MODEL=gpt-4o-mini

# --- Speech to text ----------------------------------------------------------
# browser    -> client-side Web Speech API (Chrome/Edge), default
# openai     -> server-side transcription, requires OPENAI_API_KEY
STT_PROVIDER=browser
# STT_API_KEY=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Vovingo
RATE_LIMIT_ENABLED=true
